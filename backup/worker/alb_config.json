{
  "ALBConfiguration": {
    "Name": "cyberrange-production-alb",
    "Scheme": "internet-facing",
    "IpAddressType": "ipv4",
    "Listeners": [
      {
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      },
      {
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:ap-south-1:123456789012:certificate/abc-123-def-456"
          }
        ],
        "Rules": [
          {
            "Priority": 10,
            "Conditions": [
              {
                "Field": "path-pattern",
                "Values": ["/api/*"]
              }
            ],
            "Actions": [
              {
                "Type": "forward",
                "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/cyberrange-backend-tg/987654321"
              }
            ]
          },
          {
            "Priority": 20,
            "Conditions": [
              {
                "Field": "path-pattern",
                "Values": ["/ws/*"]
              }
            ],
            "Actions": [
              {
                "Type": "forward",
                "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/cyberrange-backend-tg/987654321"
              }
            ]
          },
          {
            "Priority": 30,
            "Conditions": [
              {
                "Field": "path-pattern",
                "Values": ["/*"]
              }
            ],
            "Actions": [
              {
                "Type": "forward",
                "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/cyberrange-frontend-static-tg/123456"
              }
            ]
          }
        ]
      }
    ],
    "TargetGroups": [
      {
        "Name": "cyberrange-backend-tg",
        "Port": 8000,
        "Protocol": "HTTP",
        "HealthCheck": {
          "Path": "/api/v1/system/server-health",
          "IntervalSeconds": 30,
          "TimeoutSeconds": 5,
          "HealthyThresholdCount": 2,
          "UnhealthyThresholdCount": 3
        }
      },
      {
        "Name": "cyberrange-frontend-static-tg",
        "Port": 80,
        "Protocol": "HTTP",
        "HealthCheck": {
          "Path": "/index.html",
          "IntervalSeconds": 30
        }
      }
    ]
  }
}
