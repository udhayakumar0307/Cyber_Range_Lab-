#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


TOKEN_FILES = (
    Path("/run/cyberrange/submission-token"),
    Path("/etc/cyberrange/submission-token"),
)
API_BASE_FILES = (
    Path("/run/cyberrange/api-base"),
    Path("/etc/cyberrange/api-base"),
)


def _read_first(paths: tuple[Path, ...]) -> str | None:
    for path in paths:
        try:
            value = path.read_text(encoding="utf-8").strip()
            if value:
                return value
        except (FileNotFoundError, PermissionError, OSError):
            pass
    return None


def token() -> str:
    value = os.getenv("CYBERRANGE_SUBMISSION_TOKEN", "").strip() or _read_first(TOKEN_FILES)
    if not value:
        raise RuntimeError(
            "This workspace has no submission credential. Restart the lab or contact your instructor."
        )
    return value


def api_base() -> str:
    value = os.getenv("CYBERRANGE_API_BASE", "").strip() or _read_first(API_BASE_FILES)
    if not value:
        value = "http://host.docker.internal:8000"
    return value.rstrip("/")


def print_result(data: dict) -> int:
    print(f"Submission ID: {data.get('submission_id')}")
    print(f"Lab: {data.get('lab_id')}")
    print("=" * 72)
    for test in data.get("tests", []):
        marker = "PASS" if test.get("passed") else "FAIL"
        points = test.get("points", 0)
        maximum = test.get("max_points", 0)
        print(
            f"[{marker}] {str(test.get('id', 'criterion')):<28} "
            f"{points:>3}/{maximum:<3} {test.get('feedback', '')}"
        )
    print("-" * 72)
    print(f"Final score: {data.get('score')}/{data.get('max_score')}")
    print(f"Pass mark:   {data.get('pass_score')}")
    passed = bool(data.get("passed"))
    print(f"Outcome:     {'PASS' if passed else 'FAIL'}")
    return 0 if passed else 2


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] in {"-h", "--help"}:
        print("Usage: submit <script.sh>")
        return 0 if len(sys.argv) == 2 else 1

    path = Path(sys.argv[1]).expanduser()
    if not path.is_file():
        print(f"submit: file not found: {path}", file=sys.stderr)
        return 1
    if path.suffix != ".sh":
        print("submit: submission must be a .sh file", file=sys.stderr)
        return 1

    try:
        content = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        print("submit: script must be UTF-8 text", file=sys.stderr)
        return 1

    payload = json.dumps({"filename": path.name, "content": content}).encode("utf-8")
    endpoint = f"{api_base()}/api/v1/sysadmin-grading/workspace-submit"
    request = urllib.request.Request(
        endpoint,
        data=payload,
        method="POST",
        headers={
            "Authorization": f"Bearer {token()}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )

    print(f"Submitting {path.name} ...")
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            return print_result(json.loads(response.read().decode("utf-8")))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("detail", body)
            if isinstance(detail, dict):
                detail = detail.get("message", detail)
        except Exception:
            detail = body
        print(f"submit: server error ({exc.code}): {detail}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, TimeoutError, RuntimeError) as exc:
        print(f"submit: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
