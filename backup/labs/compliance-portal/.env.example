# ============================================================
# DPDP Compliance Portal — lab environment
# ------------------------------------------------------------
# Copy to ".env" only if you need to override a default:
#   cp .env.example .env
#
# EVERY value below is optional. With an empty .env the lab
# starts in self-contained demo mode and every page is populated
# from the bundled demo dataset with no external network.
# ============================================================

# ── Lab identity (set by the Cyber Range platform per session) ──
STUDENT_ID=student
LAB_SEED=defaultseed

# ── Host port ─────────────────────────────────────────────────
# The compose file maps this to container port 4000. Change it
# here AND in docker-compose.yml if 8090 is taken.
#   http://localhost:8090
# (docker-compose.yml controls the actual mapping; this line is
#  just a reminder of the default.)

# ── Consent source ───────────────────────────────────────────
# Unset  -> self-contained demo mode (recommended for the lab).
# Set    -> the portal analyses a real consent API.
#
# Form A — JSON map (key -> source):
# CONSENT_SOURCES={"live_key":{"url":"https://acme.example/consent-api/consents","sector":"ecommerce","label":"Acme Store"}}
#
# Form B — one variable per source, nothing to quote:
#   <key>|<url>|<sector>|<label>
# CONSENT_SOURCE_ECOM=live_key|https://acme.example/consent-api/consents|ecommerce|Acme Store
#
# Available sectors: ecommerce, finance, healthcare, insurance,
# securities, telecom, generic.
CONSENT_SOURCES=

# ── Analysis tuning ──────────────────────────────────────────
CONSENT_LIMIT=500
SYNC_INTERVAL_MINUTES=5

# ── Optional database (audit history + integration state only) ──
# Leave unset to run stateless.
# DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
# DATABASE_SSL=false

# ── Optional single-tenant branding ─────────────────────────
# VITE_TENANT_MODE=single
# VITE_TENANT_SECTOR=ecommerce
VITE_TENANT_LABEL=Privacy Shield Platform
