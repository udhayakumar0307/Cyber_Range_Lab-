# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
CONSENT_LIMIT=500              # max consent records fetched per source
SYNC_INTERVAL_MINUTES=5        # how often every source is re-analysed

# ── Consent sources: key -> { url, sector } ───────────────────────────────────
# One entry per company. The sector selects the pack under
# server/privacy/sectors/ that weights PII sensitivity and names the regulator.
# Available sectors: ecommerce, finance, healthcare, insurance, securities,
# telecom, generic.
#
# Unknown keys are rejected with 401 — a key only ever sees its own company's
# data. Adding a company is one more entry here and nothing else.
# Form A — JSON map (one variable, all sources):
CONSENT_SOURCES={"<ecommerce-key>":{"url":"https://ecommerce.sc.deeptrustxai.com/consent-api/consents","sector":"ecommerce","label":"Deeptrust Store"},"<finance-key>":{"url":"https://finance.sc.deeptrustxai.com/portal/consents","sector":"finance","label":"Deeptrust Finance"}}

# Form B — one variable per source, nothing to quote. Preferred in hosting
# panels, where a stray smart quote or line wrap in JSON silently disables
# every source. Any variable named CONSENT_SOURCE_* is read:
#   <key>|<url>|<sector>|<label>
# CONSENT_SOURCE_ECOM=<ecommerce-key>|https://ecommerce.sc.deeptrustxai.com/consent-api/consents|ecommerce|Deeptrust Store
# CONSENT_SOURCE_FIN=<finance-key>|https://finance.sc.deeptrustxai.com/portal/consents|finance|Deeptrust Finance

# Per-source options:
#   {"url":"…","sector":"finance","token":"…"}   token overrides the forwarded key
#   {"dbUrl":"postgres://…","dbSsl":true,"sector":"ecommerce"}   direct-DB (EverShop schema)

# ── Optional database ─────────────────────────────────────────────────────────
# Only stores audit history and integration state. All analysis runs without it,
# so leaving this unset is a supported production configuration.
# DATABASE_URL=postgres://postgres:postgres@localhost:5440/postgres
# DATABASE_SSL=false

# ── Tenant mode ───────────────────────────────────────────────────────────────
# Deploy the same codebase as a multi-tenant demo or a single-tenant client
# portal. When VITE_TENANT_MODE is unset or "multi", the dashboard shows all
# connected sources and the Integration page. Set to "single" to lock the UI
# to one sector and hide the Integration page.
#
# VITE_TENANT_MODE=single
# VITE_TENANT_SECTOR=ecommerce          # "ecommerce" | "finance" | any sector key
# VITE_TENANT_LABEL=Deeptrust Store     # shown in sidebar logo & navbar

# ── Frontend ──────────────────────────────────────────────────────────────────
# In Docker the frontend is served by the same process, so this stays relative.
VITE_API_BASE_URL=/api
