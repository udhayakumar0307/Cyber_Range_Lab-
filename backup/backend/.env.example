export ENV=development
export ALLOW_SQLITE_DEV=true
export DATABASE_URL="sqlite:///./cyberrange_demo.db"
# Linux Sysadmin Bash autograder (LocalDockerExecutor MVP)
# Keep the question bank private; the backend needs read access to it.
export SYSADMIN_GRADING_ENABLED=false
export SYSADMIN_QUESTION_BANK_ROOT="/absolute/path/to/cyberrange-linux-sysadmin-labs"
# Optional. Defaults to <question-bank>/.venv/bin/python when present.
# export SYSADMIN_GRADER_PYTHON="/absolute/path/to/cyberrange-linux-sysadmin-labs/.venv/bin/python"
export SYSADMIN_GRADING_TIMEOUT_SECONDS=120
export SYSADMIN_GRADING_MAX_SUBMISSION_BYTES=65536

# Linux Sysadmin terminal workspace submission credentials.
# Keep self-minting FALSE in production; the future workspace orchestrator should
# mint credentials internally after assignment authorization.
export SYSADMIN_WORKSPACE_TOKEN_TTL_MINUTES=120
export SYSADMIN_ALLOW_USER_WORKSPACE_TOKEN_MINTING=false
# Optional independent signing secret. If omitted, a domain-separated key is
# derived from SECRET_KEY so workspace tokens cannot authenticate as access JWTs.
export SYSADMIN_WORKSPACE_TOKEN_SECRET=
# LocalDockerExecutor readiness probe (development only).
export SYSADMIN_GRADING_HEALTHCHECK_IMAGE=cyberrange/rhsa-base:0.3
