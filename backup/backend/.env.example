export ENV=development
export ALLOW_SQLITE_DEV=true
export DATABASE_URL="sqlite:///./cyberrange_demo.db"

# Linux Sysadmin Bash autograder.
# Keep the question-bank checkout private; the backend uses it to validate lab IDs.
export SYSADMIN_GRADING_ENABLED=false
export SYSADMIN_QUESTION_BANK_ROOT="/absolute/path/to/cyberrange-linux-sysadmin-labs"
export SYSADMIN_GRADING_EXECUTOR=local
export SYSADMIN_GRADING_TIMEOUT_SECONDS=120
export SYSADMIN_GRADING_MAX_SUBMISSION_BYTES=65536

# LocalDockerExecutor only (development).
# Optional. Defaults to <question-bank>/.venv/bin/python when present.
# export SYSADMIN_GRADER_PYTHON="/absolute/path/to/cyberrange-linux-sysadmin-labs/.venv/bin/python"
export SYSADMIN_GRADING_HEALTHCHECK_IMAGE=cyberrange/rhsa-base:0.3

# ECSGradingExecutor only (production).
# The backend uploads one private submission object, supplies short-lived GET/PUT
# URLs to the trusted ECS worker, waits for the worker, validates result.json,
# then deletes the transient S3 objects by default.
# export SYSADMIN_GRADING_EXECUTOR=ecs
export SYSADMIN_GRADING_AWS_REGION=ap-south-1
export SYSADMIN_GRADING_ECS_CLUSTER=cyberrange-sysadmin-grading
export SYSADMIN_GRADING_ECS_TASK_DEFINITION=cyberrange-sysadmin-grader:1
export SYSADMIN_GRADING_ECS_CAPACITY_PROVIDER=sysadmin-grader-capacity
export SYSADMIN_GRADING_ECS_CONTAINER_NAME=rhsa-grading-worker
export SYSADMIN_GRADING_ECS_TASK_TIMEOUT_SECONDS=600
export SYSADMIN_GRADING_ECS_POLL_INTERVAL_SECONDS=2
export SYSADMIN_GRADING_S3_BUCKET=cyberrange-sysadmin-grading-766363046973-ap-south-1
export SYSADMIN_GRADING_S3_PREFIX=sysadmin-grading
export SYSADMIN_GRADING_S3_URL_TTL_SECONDS=900
export SYSADMIN_GRADING_S3_CLEANUP=true

# Linux Sysadmin terminal workspace submission credentials.
# Keep self-minting FALSE in production; the workspace orchestrator should mint
# credentials internally after assignment authorization.
export SYSADMIN_WORKSPACE_TOKEN_TTL_MINUTES=120
export SYSADMIN_ALLOW_USER_WORKSPACE_TOKEN_MINTING=false
# Optional independent signing secret. If omitted, a domain-separated key is
# derived from SECRET_KEY so workspace tokens cannot authenticate as access JWTs.
export SYSADMIN_WORKSPACE_TOKEN_SECRET=

# Linux Sysadmin student workspace (v0.5).
# Production uses a SEPARATE Fargate cluster. Never point this at the trusted
# cyberrange-sysadmin-grading cluster or a host that exposes the Docker socket.
export SYSADMIN_WORKSPACE_ENABLED=false
export SYSADMIN_WORKSPACE_ECS_CLUSTER=cyberrange-sysadmin-workspaces
export SYSADMIN_WORKSPACE_ECS_TASK_DEFINITION=cyberrange-sysadmin-workspace:1
export SYSADMIN_WORKSPACE_ECS_CONTAINER_NAME=rhsa-workspace
# Comma-separated VPC subnet IDs. Fargate awsvpc tasks receive one ENI each.
export SYSADMIN_WORKSPACE_SUBNET_IDS=
# Security group should allow TCP/22 ONLY from the CyberRange backend SG.
export SYSADMIN_WORKSPACE_SECURITY_GROUP_IDS=
# ENABLED is the simplest initial deployment when no NAT/VPC endpoints exist.
# Inbound access is still constrained by the workspace security group.
export SYSADMIN_WORKSPACE_ASSIGN_PUBLIC_IP=true
# Public HTTPS origin reachable from the Fargate task, e.g. https://cyberrange.example.edu
export SYSADMIN_WORKSPACE_API_BASE=
export SYSADMIN_WORKSPACE_START_TIMEOUT_SECONDS=180
export SYSADMIN_WORKSPACE_POLL_INTERVAL_SECONDS=3
export SYSADMIN_MARKETPLACE_LAB_ID=linux-sysadmin-lab
# Defaults to true in production and false in development when omitted.
export SYSADMIN_WORKSPACE_REQUIRE_MARKETPLACE_ACCESS=true
