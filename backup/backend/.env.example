# Environment Mode (development / production)
ENV=development

# JWT Configurations
SECRET_KEY=cyber_range_secret_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (supports SQLite or PostgreSQL via DATABASE_URL or individual variables)
DATABASE_URL=sqlite:///./cyberrange.db

# AWS RDS / PostgreSQL individual config variables
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Alternate DB component keys (if DATABASE_URL is not set)
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cyberrange

# Default Admin Configurations
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cyberrange.in
ADMIN_PASSWORD=password

# AWS Amazon SES Configurations
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

