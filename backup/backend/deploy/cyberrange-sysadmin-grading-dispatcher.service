[Unit]
Description=CyberRange Linux Sysadmin SQS Grading Dispatcher
After=network-online.target cyberrange-backend.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Cyber_Range_Lab-/backup/backend
# The Python application loads backup/.env through python-dotenv. Production
# .env values are not guaranteed to be valid shell syntax, so never `source` it.
# Force this process onto the EC2 instance-role credential chain while legacy
# static AWS keys remain available to the existing backend service.
Environment=CYBERRANGE_FORCE_INSTANCE_ROLE=true
Environment=AWS_SHARED_CREDENTIALS_FILE=/tmp/nonexistent-aws-credentials
Environment=AWS_CONFIG_FILE=/tmp/nonexistent-aws-config
ExecStart=/home/ubuntu/Cyber_Range_Lab-/backup/backend/venv/bin/python scripts/sysadmin_grading_dispatcher.py
Restart=always
RestartSec=5
TimeoutStopSec=700
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
